# Firebase App Hosting Environment Variables
# Firebase App Hosting automatically provides FIREBASE_CONFIG and FIREBASE_WEBAPP_CONFIG
# Our application now extracts Firebase configuration from these JSON environment variables

# App Hosting specific configuration
FIREBASE_APP_HOSTING=true
GOOGLE_CLOUD_PROJECT=getseerai
GCLOUD_PROJECT=getseerai
REGION=europe-west1
FIREBASE_REGION=europe-west1
GOOGLE_CLOUD_REGION=europe-west1

# Server configuration
PORT=8080
NODE_ENV=production

# Firebase configuration is now automatically extracted from:
# - FIREBASE_WEBAPP_CONFIG (provided by Firebase App Hosting)
# - FIREBASE_CONFIG (provided by Firebase App Hosting)
# Individual NEXT_PUBLIC_FIREBASE_* variables are no longer needed

# API URLs for App Hosting
NEXT_PUBLIC_API_URL=https://seer39--getseerai.europe-west1.hosted.app/api

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_DEBUG=false

# Health check configuration
STARTUP_TIMEOUT=60000
AUTH_INITIALIZATION_TIMEOUT=30000
