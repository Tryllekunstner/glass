rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users can only access their own data
    match /users/{userId} {
      // User document (profile)
      allow read, write: if isUser(userId);
      
      // User sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if isUser(userId);
        
        // Transcripts subcollection within sessions
        match /transcripts/{transcriptId} {
          allow read, write: if isUser(userId);
        }
        
        // AI messages subcollection within sessions
        match /aiMessages/{messageId} {
          allow read, write: if isUser(userId);
        }
        
        // Summary subcollection within sessions
        match /summary/{document=**} {
          allow read, write: if isUser(userId);
        }
      }

      // User prompt presets subcollection
      match /promptPresets/{presetId} {
        allow read, write: if isUser(userId);
      }
      
      // AI profiles subcollection - user-configurable AI model presets
      match /aiProfiles/{profileId} {
        allow read, write: if isUser(userId);
      }
      
      // User preferences and settings
      match /preferences/{document=**} {
        allow read, write: if isUser(userId);
      }

      // App settings document (source of truth for desktop)
      // Path: users/{uid}/settings/app
      match /settings {
        match /app {
          allow read, write: if isUser(userId);
        }
      }
      
      // User activity and analytics data
      match /activity/{activityId} {
        allow read, write: if isUser(userId);
      }
      
      // Encrypted API keys and sensitive data
      match /credentials/{credentialId} {
        allow read, write: if isUser(userId);
      }
    }

    // Device registry (top-level)
    // Doc must contain { id, uid, type, platform, appVersion, lastSeenAt, status, ... }
    // Users can only read and write their own device documents
    match /devices/{deviceId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Agent configurations
    // User-owned configs: doc contains { uid: request.auth.uid, ... }
    // Org-owned configs should be written via server/Admin and are read-only to clients unless explicitly user-owned
    match /agentConfigs/{configId} {
      // Allow read if the config is owned by the user
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      
      // Allow user to manage configs they own
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Organizations - managed via server/Admin. Client reads/writes are denied by default here.
    match /orgs/{orgId} {
      allow read, write: if false;
    }
    
    // Public configuration data (read-only for authenticated users)
    match /config/{document=**} {
      allow read: if isSignedIn();
      allow write: if false; // Only admins can write config (handled via Admin SDK)
    }
    
    // System status and health checks (read-only for authenticated users)
    match /system/{document=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    
    // Global AI model configurations (read-only for authenticated users)
    match /aiModels/{modelId} {
      allow read: if isSignedIn();
      allow write: if false; // Only admins can manage AI model configs
    }
    
    // Usage analytics and metrics (read-only for authenticated users)
    match /analytics/{document=**} {
      allow read: if isSignedIn();
      allow write: if false; // Only system can write analytics
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
